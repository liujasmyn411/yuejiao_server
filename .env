# ==================== 数据库配置 ====================
# 数据库类型: mysql / sqlite
DB_TYPE=mysql

# --- MySQL 配置 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=yuejiao
MYSQL_CHARSET=utf8mb4

# --- SQLite 配置 (开发用) ---
SQLITE_URL=sqlite:///./yuejiao.db

# 连接池配置
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=粤教服务 AI Agent API
API_VERSION=1.0.0

# ==================== CORS 跨域配置 ====================
CORS_ORIGINS=*

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_DIR=log

# ==================== 安全配置 ====================
# JWT Secret (请生产环境更换为随机字符串)
SECRET_KEY=yuejiao-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 心理AI Agent配置 ====================
PSYCH_AI_API_BASE=http://127.0.0.1:5000
PSYCH_AI_API_KEY=
PSYCH_AI_MODEL=psych-assistant-v1
